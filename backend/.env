# Voice Calendar Backend Environment Configuration
# 智能语音日历后端环境配置

# 基础配置
APP_NAME=Voice Calendar API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置 - 开发环境使用SQLite
DATABASE_URL=sqlite+aiosqlite:///./voice_calendar.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# CORS配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# LLM配置 - 国产模型（NLU 语义解析）
# 本地Ollama服务
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434

# Agent LLM 配置 - 国产模型双路由（技术文档 §3.1.3）
# 支持：alibaba(通义千问) / zhipu(智谱GLM) / local(本地Ollama)
AGENT_LLM_PROVIDER=alibaba

# 通义千问配置（阿里云百炼平台）
# 申请地址：https://dashscope.console.aliyun.com/
ALIBABA_API_KEY=your_alibaba_api_key_here
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_FAST_MODEL=qwen-turbo
ALIBABA_STRONG_MODEL=qwen-plus

# 智谱GLM配置（智谱AI开放平台）
# 申请地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_FAST_MODEL=glm-4-flash
ZHIPU_STRONG_MODEL=glm-4-plus

# 本地模型配置（Ollama）
AGENT_LLM_LOCAL_MODEL=qwen2.5-7b-instruct

# 意图关联判断阈值（技术文档 §3.2.1）
INTENT_EMBEDDING_SIMILARITY_THRESHOLD=0.82
INTENT_LLM_CONFIDENCE_THRESHOLD=0.7

# 联网搜索配置（技术文档 §4）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
SEARCH_CACHE_TTL_HOURS=6

# 工具超时配置（技术文档 §3.3.2）
TOOL_TIMEOUT_SEARCH_MS=3000
TOOL_TIMEOUT_CALENDAR_MS=2000
TOOL_TIMEOUT_MAP_MS=4000
TOOL_TIMEOUT_LLM_MS=8000
TOOL_TIMEOUT_REMINDER_MS=1000
TOOL_RETRY_SEARCH=2
TOOL_RETRY_CALENDAR=3
TOOL_RETRY_REMINDER=5

# STT配置 - 云端: 讯飞/SenseVoice；离线: FunASR/Paraformer + Sherpa-onnx
STT_MODEL=sensevoice-large
STT_LANGUAGE=zh

# TTS配置 - 云端: 火山引擎/讯飞；离线: ChatTTS/Sherpa-onnx VITS
TTS_MODEL=volcano-tts
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# 会话配置（设计文档 §9.7 要求 5 分钟过期）
SESSION_EXPIRE_MINUTES=5
SESSION_MAX_HISTORY=20

# 时区配置
DEFAULT_TIMEZONE=Asia/Shanghai
