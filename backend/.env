# Voice Calendar Backend Environment Configuration
# 智能语音日历后端环境配置

# 基础配置
APP_NAME=Voice Calendar API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置 - 开发环境使用SQLite
DATABASE_URL=sqlite+aiosqlite:///./voice_calendar.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# CORS配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# LLM配置
LLM_MODEL=qwen-2.5-7b
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://localhost:11434

# STT配置
STT_MODEL=faster-whisper-base
STT_LANGUAGE=zh

# TTS配置
TTS_MODEL=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 会话配置
SESSION_EXPIRE_MINUTES=30
SESSION_MAX_HISTORY=20

# 时区配置
DEFAULT_TIMEZONE=Asia/Shanghai
