# Voice Calendar Backend Environment Configuration
# 智能语音日历后端环境配置

# 基础配置
APP_NAME=Voice Calendar API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置 - 开发环境使用SQLite
DATABASE_URL=sqlite+aiosqlite:///./voice_calendar.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# CORS配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# LLM配置 - 全部使用智谱GLM
# 智谱AI开放平台：https://open.bigmodel.cn/
AGENT_LLM_PROVIDER=zhipu

# 智谱GLM配置（统一使用智谱）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# NLU语义解析模型（快速响应）
LLM_MODEL=glm-4-flash
LLM_API_KEY=your_zhipu_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Agent任务规划模型
ZHIPU_FAST_MODEL=glm-4-flash      # 快速模型，目标延迟 < 500ms
ZHIPU_STRONG_MODEL=glm-4-plus     # 强力模型，目标延迟 < 1500ms

# 意图关联判断阈值（技术文档 §3.2.1）
INTENT_EMBEDDING_SIMILARITY_THRESHOLD=0.82
INTENT_LLM_CONFIDENCE_THRESHOLD=0.7

# 联网搜索配置（技术文档 §4）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
SEARCH_CACHE_TTL_HOURS=6

# 工具超时配置（技术文档 §3.3.2）
TOOL_TIMEOUT_SEARCH_MS=3000
TOOL_TIMEOUT_CALENDAR_MS=2000
TOOL_TIMEOUT_MAP_MS=4000
TOOL_TIMEOUT_LLM_MS=8000
TOOL_TIMEOUT_REMINDER_MS=1000
TOOL_RETRY_SEARCH=2
TOOL_RETRY_CALENDAR=3
TOOL_RETRY_REMINDER=5

# STT配置 - 云端: 讯飞/SenseVoice
STT_MODEL=sensevoice-large
STT_LANGUAGE=zh

# TTS配置 - 云端: 火山引擎/讯飞
TTS_MODEL=volcano-tts
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# 会话配置（设计文档 §9.7 要求 5 分钟过期）
SESSION_EXPIRE_MINUTES=5
SESSION_MAX_HISTORY=20

# 时区配置
DEFAULT_TIMEZONE=Asia/Shanghai
